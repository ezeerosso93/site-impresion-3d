---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard';
import { supabase } from '../lib/supabase';

// Fetch destacado products or use mock backup if Supabase is placeholder
let highlightedProducts = [];
let materials = [];

try {
  const { data: pData } = await supabase
    .from('productos_3d')
    .select('*')
    .eq('destacado', true)
    .limit(3);
  
  const { data: mData } = await supabase
    .from('materiales_3d')
    .select('*');

  if (pData && pData.length > 0) {
    highlightedProducts = pData;
  }
  if (mData && mData.length > 0) {
    materials = mData;
  }
} catch (e) {
  console.log("Supabase fetch skipped or errored, using mock fallback.");
}

// Fallback mock values
if (highlightedProducts.length === 0) {
  highlightedProducts = [
    {
      id: 'prod3d-001',
      nombre: 'Soporte de Auriculares Minimalista',
      descripcion: 'Soporte de diseño moderno para auriculares gamer u oficina. Cuenta con base antideslizante y canal de cables.',
      precio: 3500,
      peso_estimado: 85,
      tiempo_impresion: 240,
      material_sugerido: 'PLA',
      imagen_url: 'https://images.unsplash.com/photo-1549298916-b41d501d3772?w=400',
      stock: 15,
      destacado: true
    },
    {
      id: 'prod3d-002',
      nombre: 'Maceta Autorregante Hexagonal',
      descripcion: 'Maceta inteligente con sistema de auto-riego impreso en PETG para máxima estanqueidad. Diseño geométrico elegante.',
      precio: 4800,
      peso_estimado: 120,
      tiempo_impresion: 360,
      material_sugerido: 'PETG',
      imagen_url: 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=400',
      stock: 8,
      destacado: true
    }
  ];
}

if (materials.length === 0) {
  materials = [
    { nombre: 'PLA (Estándar)', precio_por_gramo: 12 },
    { nombre: 'PETG (Resistente/Estanco)', precio_por_gramo: 15 },
    { nombre: 'ABS (Térmico/Mecánico)', precio_por_gramo: 18 }
  ];
}
---

<Layout>
  <Navbar />
  
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-24 md:py-32">
      <!-- Background glow effects -->
      <div class="absolute top-[-10%] left-[-10%] h-[500px] w-[500px] rounded-full bg-blue-500/10 blur-[120px]"></div>
      <div class="absolute bottom-[-10%] right-[-10%] h-[500px] w-[500px] rounded-full bg-indigo-500/10 blur-[120px]"></div>
      
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div class="max-w-2xl text-left">
            <span class="inline-flex items-center rounded-full bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-400 border border-blue-500/20">
              Fabricación Digital Inmediata
            </span>
            <h1 class="mt-6 font-outfit text-4xl font-extrabold tracking-tight text-white sm:text-6xl leading-tight">
              Tus ideas hechas realidad con <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">Impresión 3D</span>
            </h1>
            <p class="mt-6 text-lg text-slate-400 leading-relaxed">
              Subí tus diseños STL/3MF y obtené cotizaciones rápidas para prototipos funcionales, repuestos industriales o figuras decorativas personalizadas con filamentos premium.
            </p>
            <div class="mt-10 flex flex-wrap gap-4">
              <a 
                href="/cotizar" 
                class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-3.5 text-base font-semibold text-white shadow-xl shadow-blue-500/20 hover:from-blue-500 hover:to-indigo-500 transition-all hover:-translate-y-0.5"
              >
                Subir Archivo STL
              </a>
              <a 
                href="/productos" 
                class="inline-flex items-center justify-center rounded-xl bg-white/5 border border-white/10 px-6 py-3.5 text-base font-semibold text-slate-200 hover:bg-white/10 hover:text-white transition-all hover:-translate-y-0.5"
              >
                Ver Vidriera Virtual
              </a>
            </div>
          </div>
          
          <!-- Decorative SVG/Card Mockup for 3D printing representation -->
          <div class="relative mx-auto w-full max-w-md lg:max-w-none flex justify-center">
            <div class="relative w-full max-w-[400px] aspect-square rounded-2xl border border-white/5 bg-[#0e1017]/80 p-8 shadow-2xl backdrop-blur-sm overflow-hidden flex flex-col justify-between">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-indigo-500/10 opacity-30"></div>
              
              <div class="flex items-center justify-between border-b border-white/5 pb-4 relative">
                <div>
                  <p class="text-xs text-slate-500 font-semibold uppercase">Filamento Activo</p>
                  <p class="text-sm font-bold text-white">PLA Premium Azul</p>
                </div>
                <div class="h-3 w-3 rounded-full bg-blue-500 animate-pulse"></div>
              </div>
              
              <!-- 3D Printer Nozzle ASCII art style animation / premium visual placeholder -->
              <div class="my-6 flex-1 flex flex-col items-center justify-center relative">
                <svg class="w-40 h-40 text-blue-500/70" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M20 70 L50 20 L80 70 Z" stroke="currentColor" stroke-width="2" stroke-dasharray="4 2"/>
                  <circle cx="50" cy="20" r="4" fill="currentColor"/>
                  <path d="M30 70 C30 80, 70 80, 70 70" stroke="currentColor" stroke-width="3"/>
                  <path d="M50 20 L50 90" stroke="url(#gradient)" stroke-width="2" stroke-linecap="round"/>
                  <defs>
                    <linearGradient id="gradient" x1="50" y1="20" x2="50" y2="90" gradientUnits="userSpaceOnUse">
                      <stop stop-color="#3b82f6"/>
                      <stop offset="1" stop-color="#6366f1" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                </svg>
                <div class="absolute bottom-2 text-center">
                  <p class="text-xs font-semibold text-slate-400">Imprimiendo Objeto 3D...</p>
                  <p class="text-[10px] text-slate-500">Progreso estimado: 78%</p>
                </div>
              </div>
              
              <div class="border-t border-white/5 pt-4 flex justify-between text-xs text-slate-400 relative">
                <span>Temp: 210°C</span>
                <span>Peso: 142g</span>
                <span>Tiempo: 4h 12m</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services / Benefits -->
    <section class="py-20 border-t border-white/5 bg-[#07080b]/60">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="font-outfit text-3xl font-bold text-white sm:text-4xl">
            Soluciones de Fabricación Flexible
          </h2>
          <p class="mt-4 text-base text-slate-400">
            Utilizamos tecnologías FDM (Modelado por Deposición Fundida) de precisión con diversos tipos de plásticos según la necesidad del proyecto.
          </p>
        </div>

        <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {/* Card 1 */}
          <div class="rounded-xl border border-white/5 bg-[#0e1017] p-8 hover:border-blue-500/20 transition-all">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-500/10 text-blue-400 mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
            </div>
            <h3 class="font-outfit text-lg font-bold text-white">Piezas Personalizadas</h3>
            <p class="mt-3 text-sm text-slate-400 leading-relaxed">
              Subí tu archivo STL/3MF, elegí el filamento y recibí el presupuesto final. Imprimimos lo que necesites sin mínimo de unidades.
            </p>
          </div>

          {/* Card 2 */}
          <div class="rounded-xl border border-white/5 bg-[#0e1017] p-8 hover:border-blue-500/20 transition-all">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-indigo-500/10 text-indigo-400 mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            </div>
            <h3 class="font-outfit text-lg font-bold text-white">Variedad de Materiales</h3>
            <p class="mt-3 text-sm text-slate-400 leading-relaxed">
              Ofrecemos PLA ecológico para modelos estéticos, PETG para piezas impermeables de exterior y ABS de grado de ingeniería.
            </p>
          </div>

          {/* Card 3 */}
          <div class="rounded-xl border border-white/5 bg-[#0e1017] p-8 hover:border-blue-500/20 transition-all">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-purple-500/10 text-purple-400 mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="font-outfit text-lg font-bold text-white">Despacho y Entrega Rápida</h3>
            <p class="mt-3 text-sm text-slate-400 leading-relaxed">
              Optimizamos los tiempos de impresión con nuestra granja de impresoras 3D calibradas para asegurar entregas en plazos mínimos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlighted Catalog Showcase -->
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12">
          <div>
            <h2 class="font-outfit text-3xl font-bold text-white">
              Modelos Destacados
            </h2>
            <p class="mt-2 text-slate-400 text-sm">
              Descubrí algunas de nuestras piezas más solicitadas y listas para fabricar.
            </p>
          </div>
          <a href="/productos" class="mt-4 md:mt-0 text-sm font-semibold text-blue-400 hover:text-blue-300 inline-flex items-center gap-1">
            Ver catálogo completo <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {highlightedProducts.map((product) => (
            <ProductCard client:load product={product} />
          ))}
        </div>
      </div>
    </section>

    <!-- Interactive Materials Cost Calculator -->
    <section class="py-20 border-t border-white/5 bg-[#07080b]/60">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto rounded-2xl border border-white/5 bg-[#0e1017] p-8 md:p-12 relative overflow-hidden">
          <div class="absolute top-0 right-0 h-40 w-40 rounded-full bg-blue-500/5 blur-[50px]"></div>
          
          <h2 class="font-outfit text-2xl font-bold text-white sm:text-3xl text-center">
            Calculadora Rápida de Costo
          </h2>
          <p class="mt-2 text-slate-400 text-sm text-center">
            Si ya conocés el peso de tu archivo STL en gramos (obtenido desde tu slicer como Cura o PrusaSlicer), podés estimar el valor del material de tu impresión.
          </p>

          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <div class="space-y-4">
              <div>
                <label for="calc-weight" class="block text-xs font-semibold uppercase text-slate-400 mb-2">Peso de la pieza (gramos)</label>
                <input 
                  type="number" 
                  id="calc-weight" 
                  placeholder="Ej: 50" 
                  class="w-full h-10 rounded-lg border border-white/10 bg-[#07080b] px-3 text-sm text-white focus:outline-none focus:border-blue-500"
                  min="1"
                />
              </div>

              <div>
                <label for="calc-material" class="block text-xs font-semibold uppercase text-slate-400 mb-2">Material / Filamento</label>
                <select 
                  id="calc-material" 
                  class="w-full h-10 rounded-lg border border-white/10 bg-[#07080b] px-3 text-sm text-white focus:outline-none focus:border-blue-500"
                >
                  {materials.map((mat) => (
                    <option value={mat.precio_por_gramo}>{mat.nombre} (${mat.precio_por_gramo}/g)</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="flex flex-col justify-center items-center rounded-xl bg-[#07080b] border border-white/5 p-6 text-center">
              <span class="text-xs uppercase font-semibold text-slate-500">Costo Estimado Material</span>
              <span id="calc-result" class="mt-2 text-4xl font-extrabold text-white">$ 0</span>
              <span class="mt-2 text-[10px] text-slate-500">Este valor es orientativo y no incluye base de preparación, horas de máquina o soportes complejos.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<script>
  const weightInput = document.getElementById('calc-weight') as HTMLInputElement | null;
  const materialSelect = document.getElementById('calc-material') as HTMLSelectElement | null;
  const resultDisplay = document.getElementById('calc-result');

  function updateCost() {
    if (!weightInput || !materialSelect || !resultDisplay) return;
    
    const weight = parseFloat(weightInput.value) || 0;
    const pricePerGram = parseFloat(materialSelect.value) || 0;
    const cost = weight * pricePerGram;
    
    resultDisplay.textContent = new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(cost);
  }

  if (weightInput && materialSelect) {
    weightInput.addEventListener('input', updateCost);
    materialSelect.addEventListener('change', updateCost);
  }
</script>
