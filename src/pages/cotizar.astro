---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QuoteRequestForm from '../components/QuoteRequestForm';
---

<Layout title="Cotizar Pieza 3D Personalizada | RossoPrints">
  <Navbar />

  <main class="flex-1 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center rounded-full bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-400 border border-blue-500/20">
          Servicio de Fabricación a Demanda
        </span>
        <h1 class="mt-4 font-outfit text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          Cotizá tu Diseño 3D
        </h1>
        <p class="mt-3 text-base text-slate-400">
          Subí tu archivo de modelado, seleccioná el material y dejanos tus especificaciones. Recibirás tu presupuesto detallado con peso estimado, tiempo y precio final en tu correo.
        </p>
      </div>

      <QuoteRequestForm client:load />
    </div>
  </main>

  <Footer />
</Layout>
