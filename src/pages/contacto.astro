---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto | RossoPrints">
  <Navbar />

  <main class="flex-1 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="font-outfit text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          Contactanos
        </h1>
        <p class="mt-3 text-base text-slate-400">
          ¿Tenés alguna duda sobre materiales, volumen de impresión o diseños complejos? Escribinos directamente o visitanos.
        </p>
      </div>

      <div class="grid gap-12 lg:grid-cols-2 lg:items-center max-w-5xl mx-auto">
        <!-- Contact details -->
        <div class="space-y-8">
          <div class="flex gap-4">
            <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-500/10 text-blue-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">Teléfono / WhatsApp</h3>
              <p class="mt-1 text-sm text-slate-400">+54 9 11 2233-4455</p>
              <p class="text-xs text-slate-500">Atención de Lunes a Viernes de 9:00 a 18:00 hs.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-500/10 text-indigo-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">Correo Electrónico</h3>
              <p class="mt-1 text-sm text-slate-400">impresiones@rosso.com</p>
              <p class="text-xs text-slate-500">Respondemos en menos de 24 horas.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-purple-500/10 text-purple-400 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-white">Taller de Impresión</h3>
              <p class="mt-1 text-sm text-slate-400">Palermo, Ciudad Autónoma de Buenos Aires, Argentina</p>
              <p class="text-xs text-slate-500">Solo retiro de pedidos coordinados previamente.</p>
            </div>
          </div>
        </div>

        <!-- WhatsApp Quick Connect Panel -->
        <div class="rounded-2xl border border-white/5 bg-[#0e1017] p-8 text-center relative overflow-hidden">
          <div class="absolute top-0 right-0 h-40 w-40 rounded-full bg-green-500/5 blur-[50px]"></div>
          
          <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-green-500/10 text-green-400 mb-6">
            <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.73-1.45L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.59 1.977 14.113.953 11.487.953c-5.43 0-9.856 4.371-9.86 9.8-.001 1.774.475 3.508 1.378 5.081l-.972 3.548 3.628-.949zM15.75 12.668c-.205-.102-1.213-.594-1.4-.662-.187-.068-.323-.102-.458.102-.136.205-.527.662-.646.8-.119.136-.238.153-.443.051-1.44-.72-2.31-1.282-3.14-2.709-.22-.381.22-.354.63-.997.07-.113.034-.213-.017-.315-.05-.102-.458-1.101-.627-1.509-.164-.399-.344-.344-.458-.35-.119-.006-.255-.006-.39-.006-.136 0-.356.051-.543.255-.187.205-.713.697-.713 1.7 0 1.003.73 1.972.83 2.109.1.136 1.437 2.196 3.483 3.078.487.21 1.012.336 1.487.35.487.014.928-.21 1.278-.261.391-.057 1.213-.497 1.383-.979.17-.482.17-.895.119-.979-.05-.085-.187-.136-.391-.238z"/>
            </svg>
          </div>
          
          <h3 class="font-outfit text-xl font-bold text-white mb-2">Conectá con un Operador</h3>
          <p class="text-sm text-slate-400 mb-6 leading-relaxed">
            Hacé click abajo para abrir un chat directo de WhatsApp. Podemos asesorarte con los archivos 3D o con el estado de tu orden en tiempo real.
          </p>
          
          <a
            href="https://wa.me/5491122334455?text=Hola!%20Quería%20hacer%20una%20consulta%20sobre%20impresiones%203D."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl bg-green-600 hover:bg-green-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-green-600/10 transition-all hover:-translate-y-0.5"
          >
            Chatear por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
